{
  "name": "jscript-editor",
  "version": "0.3.3",
  "private": true,
  "description": "Il tuo spazio per scrivere. Un editor desktop locale, pulito ed essenziale.",
  "author": "Jacopo",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "pack": "npm run build && node scripts/package-portable.mjs JScript-0.3.3-Windows",
    "pack:exe": "electron-builder --prepackaged release/JScript-0.3.3-Windows --win portable --x64",
    "pack:installer": "electron-builder --prepackaged release/JScript-0.3.3-Windows --win nsis --x64",
    "test:desktop": "node tests/desktop.cjs && node tests/layout-desktop.cjs && node tests/pagination-desktop.cjs && node tests/pagination-hanging-indent.cjs && node tests/columns-desktop.cjs && node tests/ribbon-desktop.cjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-text-style": "^3.0.0",
    "@tiptap/html": "^3.32.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "docx": "^9.5.0",
    "dompurify": "^3.2.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.0",
    "tiptap-pagination-plus": "3.1.0",
    "tiptap-table-plus": "3.1.0",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "happy-dom": "^20.14.6"
  },
  "build": {
    "appId": "it.jacopo.jscript",
    "productName": "JScript",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "JScript-${version}-Windows.exe"
    },
    "nsis": {
      "artifactName": "JScript-${version}-Setup-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "packElevateHelper": false
    }
  }
}
